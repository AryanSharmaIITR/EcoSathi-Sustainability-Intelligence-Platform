ENVIRONMENT=local

# PostgreSQL connection. Either:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ecosathi
# or the Vercel-hosted Postgres URLs (Prisma/Neon) — the app auto-converts
# these to the asyncpg driver:
#   EcoSathiDataBase_POSTGRES_URL=postgres://user:pass@<host>.prisma.io:5432/postgres?sslmode=require
#   EcoSathiDataBase_PRISMA_DATABASE_URL=postgres://user:pass@<host>.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=your-postgres-url-here
SECRET_KEY=changeme
DEBUG=true

# AI/ML layer — v1 uses only free-tier hosted APIs, per the spec (no fine-tuning,
# no custom training pipeline). Get a free key at https://console.groq.com/keys
#
# Groq is the ONLY external AI API v1 needs:
#   - Waste classification: Groq vision-capable chat completion (this key).
#   - Consumption forecasting: local scikit-learn regression — no API key needed.
#   - Agent orchestration: reuses this same Groq key (tool-calling model, via LangGraph).
GROQ_API_KEY=your-groq-api-key-here
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_ORCHESTRATION_MODEL=openai/gpt-oss-120b
